# ThreatScope AI Configuration

# Anthropic API Key (required for Claude classification)
ANTHROPIC_API_KEY=your_api_key_here

# Reddit API Credentials (for data collection)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ThreatScope/1.0 (by YourUsername)

# Bluesky Credentials (optional)
BLUESKY_USERNAME=your_bluesky_username
BLUESKY_PASSWORD=your_bluesky_password

# Database path
DB_PATH=threatscope.db

# Optional: Custom configuration overrides
# Uncomment to override default settings
# CONFIDENCE_THRESHOLD=medium
# REDDIT_POSTS_PER_SUBREDDIT=200
